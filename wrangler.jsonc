{
  // Auto-detected by `wrangler deploy`, so Cloudflare Workers Builds needs no
  // --config flag. The build command below regenerates the worker and assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liner-web",
  "main": "worker/index.mjs",
  "build": {
    "command": "npm run build:web"
  },
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
