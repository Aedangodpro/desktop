{
  // Auto-detected by `wrangler deploy`, so Cloudflare Workers Builds needs no
  // --config flag. Build first: VITE_API_URL=/__liner pnpm build:web &&
  // node scripts/emit-sites-worker.mjs
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liner-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
