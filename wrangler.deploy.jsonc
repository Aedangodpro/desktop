{
  // Deploys the browser build to Cloudflare Workers (free plan, no card).
  // Build first: VITE_API_URL=/__liner pnpm build:web && node scripts/emit-sites-worker.mjs
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liner-web",
  "main": "worker/index.mjs",
  "build": {
    "command": "npm run build:web"
  },
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    // Without this the asset layer answers before the worker, so the relay
    // endpoints and the immutable asset headers never run.
    "run_worker_first": true,
    // SPA fallback lives in the worker, so missing files still 404.
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
