{
  // Deploys the browser build to Cloudflare Workers (free plan, no card).
  // Build first: VITE_API_URL=/__liner pnpm build:web && node scripts/emit-sites-worker.mjs
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liner-web",
  "main": "worker/index.mjs",
  "build": {
    "command": "pnpm build:web && node scripts/emit-sites-worker.mjs"
  },
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
